# Client-visible Amplitude project key used by the Vite application.
# Copy this file to .env.local for local overrides.
VITE_AMPLITUDE_API_KEY=your_amplitude_project_api_key

# Optional value from 0 to 1. Development defaults to 1; production defaults to 0.01.
VITE_AMPLITUDE_SESSION_REPLAY_SAMPLE_RATE=0.01
