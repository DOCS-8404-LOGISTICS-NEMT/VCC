# Client-visible Amplitude project key used by the Vite application.
# Copy this file to .env.local for local overrides.
VITE_AMPLITUDE_API_KEY=your_amplitude_project_api_key

# Optional value from 0 to 1. Development defaults to 1; production defaults to 0.01.
VITE_AMPLITUDE_SESSION_REPLAY_SAMPLE_RATE=0.01

# Future Doc D server integration.
# SECURITY: OPENAI_API_KEY is server-side only. Never prefix it with VITE_, commit a real key,
# expose it to browser JavaScript, analytics, logs, or client bundles.
OPENAI_API_KEY=your_server_side_openai_api_key

# Public browser endpoint for the Future Doc D guide. Configure this only after the server route exists.
VITE_DOC_D_API_ENDPOINT=/api/doc-d
